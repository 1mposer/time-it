# Meteosource API key (required) — get one at https://www.meteosource.com/
API_KEY=your_meteosource_key_here

# Server port (optional; defaults to 3000)
PORT=3000

# --- Push path (#6c) ---
# Postgres connection string (Railway injects this on deploy)
DATABASE_URL=postgres://localhost:5432/timeit

# APNs credentials (Apple Developer portal). APNS_KEY is the FULL .p8 PEM
# CONTENT (not a file path — Railway has no secret files); literal \n escapes
# are tolerated and normalised.
APNS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
