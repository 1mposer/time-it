# Meteosource API key (required) — get one at https://www.meteosource.com/
API_KEY=your_meteosource_key_here

# Server port (optional; defaults to 3000)
PORT=3000

# --- Push path (#6c) ---
# Postgres connection string (Railway injects this on deploy)
DATABASE_URL=postgres://localhost:5432/timeit

# APNs credentials (Apple Developer portal). APNS_KEY is the FULL .p8 PEM
# CONTENT (not a file path — Railway has no secret files); literal \n escapes
# are tolerated and normalised.
APNS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX

# Push topic — MUST equal the installed app's bundle identifier.
# Optional: defaults to com.timeit.app.dev (the app's registered App ID).
# APNS_TOPIC=com.timeit.app.dev

# --- Traffic limits (all optional; the values shown are the built-in defaults) ---
# observe = log only (the default); enforce = answer 429 on the per-client
# request limits and refuse per-client provider misses over their limit.
# RATE_LIMIT_MODE=observe
# Per-client requests on /api/v1/* (IPv6 counted per /64).
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_PER_HOUR=1000
# RATE_LIMIT_FEEDBACK_PER_HOUR=30
# Provider calls started by outside traffic (cache misses). Over the budget or
# the concurrency cap, /rating serves the last good forecast or answers 502.
# The scheduled jobs are never counted.
# PROVIDER_OUTSIDE_BUDGET_PER_HOUR=60
# PROVIDER_OUTSIDE_CONCURRENCY=8
# PROVIDER_MISSES_PER_CLIENT_PER_HOUR=20
# Weather cache size, in 2 dp cells.
# WEATHER_CACHE_MAX_ENTRIES=1000
